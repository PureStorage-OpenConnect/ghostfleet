# GhostFleet controller configuration.
# Copy this file to `.env` next to docker-compose.yml and adjust.

# REQUIRED — the host network interface attached to the isolated portgroup
# (the IPv6-only network the generated VMs PXE-boot on). Find it with
# `ip -br link`: it is the interface WITHOUT your management IP.
GHOSTFLEET_ISOLATED_IF=ens34

# RECOMMENDED — password for the web UI / API. Empty or unset = open access.
#GHOSTFLEET_PASSWORD=change-me

# Optional — static API keys for automation (comma-separated), e.g. for
# triggering incremental runs from a backup-job post script.
#GHOSTFLEET_API_KEYS=

# Optional — discovery of unknown VMs on the isolated network (e.g. backup
# restores of ghost VMs, which come up with a fresh MAC): they PXE-boot into
# the temp OS with a report-only token and can then be adopted and verified.
# On by default; set to "off" to tell unknown machines to give up instead.
#GHOSTFLEET_DISCOVERY=on

# Optional — Secure attribute on the UI session cookie. Unset = auto: Secure
# when the request arrived over TLS or a reverse proxy in front of the
# controller sends X-Forwarded-Proto: https. Set "on" if your TLS proxy does
# not send that header, "off" to never set it.
#GHOSTFLEET_SECURE_COOKIES=

# Optional — pin a release instead of following `latest`. Recommended for
# labs that value repeatability; upgrade deliberately by bumping the pin and
# running `docker compose pull && docker compose up -d`.
#GHOSTFLEET_VERSION=v1.0.0

# Optional — pull images from a different registry/namespace (e.g. an
# internal mirror).
#GHOSTFLEET_IMAGE_PREFIX=ghcr.io/purestorage-openconnect/ghostfleet
