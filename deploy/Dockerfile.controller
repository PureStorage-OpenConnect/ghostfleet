# Build the web UI
FROM node:26-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY web/ ./
RUN npm run build

# Build the controller binary
FROM golang:1.26-alpine AS go
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build \
    -ldflags "-X github.com/PureStorage-OpenConnect/ghostfleet/internal/buildinfo.Version=${VERSION}" \
    -o /controller ./cmd/controller

# Runtime image
FROM alpine:3.22
RUN adduser -D -H ghostfleet \
    && mkdir -p /var/lib/ghostfleet \
    && chown ghostfleet /var/lib/ghostfleet
COPY --from=go /controller /usr/local/bin/controller
COPY --from=web /src/web/dist /usr/share/ghostfleet/web
USER ghostfleet
EXPOSE 8080
ENTRYPOINT ["controller", "-web", "/usr/share/ghostfleet/web", "-data", "/var/lib/ghostfleet", "-images", "/var/lib/ghostfleet/images"]
